---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/display.ts';
import { render } from 'astro:content';
interface Props { entries: CollectionEntry<'log'>[]; total: number }
const { entries, total } = Astro.props;
const rendered = await Promise.all(entries.map(async e => ({ e, Content: (await render(e)).Content })));
---
{entries.length > 0 && (
<section id="log"><img class="log-cat" src="/yuuko-bird-explosion.gif" alt="" aria-hidden="true" width="130" height="304" loading="lazy" decoding="async"/><div class="c">
  <div class="sh">
    <span class="eyebrow">Log</span>
    <h2 class="disp">What I'm Reading,<br>Building, Learning</h2>
    <p>Updated whenever something happens. Read, built, learned, watched.</p>
  </div>
  <div class="log">
    {rendered.map(({ e, Content }) => (
      <div class="li">
        <div class="m"><i>{e.data.kind}</i><span>{formatDate(e.data.date)}</span></div>
        <h4><a href={`/log/${e.id.replace(/\.md$/i, '')}/`}>{e.data.title}</a></h4>
        <p><Content /></p>
        {e.data.url && <a class="log-source" href={e.data.url} target="_blank" rel="noopener noreferrer">Read original ↗</a>}
      </div>
    ))}
  </div>
  <div class="log-archive-cta"><span>{total} notes and papers logged</span><a class="ghost" href="/log/">Explore all reading →</a></div>
</div></section>
)}

---
import type { CollectionEntry } from 'astro:content';
import ProjectArt from './ProjectArt.astro';
import { resolveArtSlug } from '../lib/project-art.ts';
interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
{projects.length > 0 && (
<section id="work"><img class="work-cat" src="/hakase-shark-bite.gif" alt="" aria-hidden="true" width="180" height="135" loading="lazy" decoding="async"/><div class="c-wide">
  <div class="sh">
    <span class="eyebrow">Selected work</span>
    <h2 class="disp">Things I Built<br>And Shipped</h2>
    <p>Every one of these has either real users, a live demo, or a review that found something I missed.</p>
  </div>
  <div class="grid">
    {projects.map(p => (
      <article class="pc">
        <div class="pc-art"><ProjectArt slug={resolveArtSlug(p.data.name)} /></div>
        <div class="pc-head">
          <span class="pc-no">{pad(p.data.order)}</span>
          <h3>{p.data.name}</h3>
        </div>
        {p.data.story && <p class="pc-story">{p.data.story}</p>}
        <p class="pc-sum">{p.data.summary}</p>
        {p.data.metrics && p.data.metrics.length > 0 && (
          <p class="met">{p.data.metrics.join(' · ')}</p>
        )}
        <div class="lk">
          {p.data.repo && <a href={p.data.repo} target="_blank" rel="noopener noreferrer">Repository</a>}
          {p.data.demo && <a href={p.data.demo} target="_blank" rel="noopener noreferrer">Live demo</a>}
        </div>
      </article>
    ))}
  </div>
</div></section>
)}

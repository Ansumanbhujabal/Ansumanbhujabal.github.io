---
import type { LogView } from '../../lib/log/types';
import { categorySlug, groupLogsByMonth } from '../../lib/log/query';
import LogRow from './LogRow.astro';
interface Props {
  entries: LogView[];
  allEntries: LogView[];
  currentPage?: number;
  pageCount?: number;
  basePath?: string;
  category?: string;
}
const { entries, allEntries, currentPage = 1, pageCount = 1, basePath = '/log', category } = Astro.props;
const groups = groupLogsByMonth(entries);
const counts = [...allEntries.reduce((map, entry) => map.set(entry.category, (map.get(entry.category) ?? 0) + 1), new Map<string, number>())];
const pageHref = (page: number) => page === 1 ? `${basePath}/` : `${basePath}/page/${page}/`;
const monthName = (key: string) => new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${key}-01T00:00:00Z`));
---
<section class="log-archive" aria-labelledby="archive-title">
  <div class="log-toolbar">
    <label>Search <input type="search" data-log-search placeholder="Search titles, sources, tags" /></label>
    <label>Sort <select data-log-sort><option value="newest">Newest</option><option value="oldest">Oldest</option><option value="title">Title</option></select></label>
  </div>
  <nav class="log-categories" aria-label="Log categories">
    <a href="/log/">All <span>{allEntries.length}</span></a>
    {counts.map(([category, count]) => <a href={`/log/category/${categorySlug(category)}/`}>{category} <span>{count}</span></a>)}
  </nav>
  <p class="log-empty" data-log-empty hidden>No matching entries.</p>
  <div data-log-results data-category={category}>
    {[...groups].map(([month, monthEntries]) => (
      <section class="log-month">
        <h2>{monthName(month)}</h2>
        {monthEntries.map(entry => <LogRow entry={entry} />)}
      </section>
    ))}
  </div>
  <nav class="log-pagination" data-log-pagination aria-label="Log pagination">
    {currentPage > 1 ? <a href={pageHref(currentPage - 1)}>← Newer</a> : <span />}
    <span>Page {currentPage} of {pageCount}</span>
    {currentPage < pageCount ? <a href={pageHref(currentPage + 1)}>Earlier →</a> : <span />}
  </nav>
</section>
<script>
  import '../../scripts/log-search';
</script>
